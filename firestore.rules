rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users collection
    // Document ID = Firebase Auth UID
    match /users/{userId} {
      // Any authenticated user can read their own or others profile for display
      allow read: if isAuthenticated();
      // Only the user themselves or an admin can write
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Categories collection
    match /categories/{categoryId} {
      // Authenticated users can read active categories
      allow read: if isAuthenticated();
      // Any authenticated user can create a category (or restricted to admin)
      allow create: if isAuthenticated() && request.resource.data.created_by == request.auth.uid;
      // Creator or admin can update (e.g. rename or soft-delete with is_active: false)
      allow update: if isAuthenticated() && 
        (resource.data.created_by == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Transactions collection
    match /transactions/{transactionId} {
      // Users can only read their own non-deleted transactions
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      // Users can only create transactions owned by themselves
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      // Users can update or soft-delete (is_deleted: true) their own transactions
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 4. App Config (Version & Update check)
    match /app_config/{configId} {
      // Anyone can read and initialize config
      allow read, write: if true;
    }

    // 5. Notes collection (Personal notes, debts, loans)
    match /notes/{noteId} {
      // Users can only read their own notes
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      // Users can only create notes owned by themselves
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      // Users can update or soft-delete (is_active: false) their own notes
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
